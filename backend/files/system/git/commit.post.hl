/*
 * Commits all changes in a Git repository, attributing the commit to the
 * authenticated user's name and email from the users_extra table.
 */
.arguments

   // Mandatory folder to where Git repo is locally on disk.
   path:string

   // Mandatory message for commit.
   message:string

// Ensuring user is root.
auth.ticket.verify:root

// Sanity checking invocation.
validators.mandatory:x:@.arguments/*/path
validators.mandatory:x:@.arguments/*/message

// Sanity checking invocation.
if
   and
      not
         strings.starts-with:x:@.arguments/*/path
            .:/modules/
      not
         strings.starts-with:x:@.arguments/*/path
            .:/etc/
   .lambda
      throw:"Git repos must be in folders inside of either '/etc/' or '/modules/'"

// Reading the commit identity of the authenticated user.
io.file.execute:/system/git/identity.hl

// Invoking slot.
git.commit:x:@.arguments/*/path
   message:x:@.arguments/*/message
   name:x:@io.file.execute/*/name
   email:x:@io.file.execute/*/email

// Returning result to caller.
yield
   result:x:@git.commit
